# Same AWS credentials pattern as yoruba-prompt-experiment — Claude runs via
# Amazon Bedrock. Copy to .env and fill in.

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# ASR layer (only needed for /chat/voice)
ASR_MODEL_CARD=omniASR_CTC_300M_v2
ASR_LANG=yor_Latn

# TTS layer (only needed for /chat/voice) — paths to the downloaded
# WavTokenizer checkpoint, see PLAN.md "Setup"
WAV_TOKENIZER_MODEL_PATH=
WAV_TOKENIZER_CONFIG_PATH=
TTS_SPEAKER=yoruba_female2
