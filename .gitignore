# Secrets — never commit these
.env
*.env
**/.env
*/.env

# Scratch/planning
.tmp/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# OS
.DS_Store

# Heavy data — audio clips, pulled datasets, model checkpoints.
# These are regenerated by the pull/finetune scripts (see each phase's
# PLAN.md), not source code — keeping them out of git keeps the repo
# small and avoids committing data with unclear/unverified licensing
# (see phase1-data/PLAN.md's licensing notes).
phase2-asr/data/
**/results/finetune_checkpoint/
*.wav
*.mp3
*.flac
*.bin
*.safetensors
*.ckpt
*.pt
*.pth

# Local runtime state (generated by running the apps, not source)
*.db
*.sqlite
*.sqlite3
