# Copy this file to .env and fill in your AWS credentials.
# ALL THREE providers (Claude Haiku 4.5, Kimi, GLM) run through Amazon
# Bedrock under this one set of credentials — no separate Moonshot/Zhipu
# API keys needed. Verify what's actually available in your account with:
#   aws bedrock list-foundation-models --region us-east-1
# (model access, especially to third-party ON_DEMAND models, varies by
# account and region — don't assume the defaults below are enabled for you)

AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1

# ============================================================
# Claude Haiku 4.5 — Anthropic, Bedrock Messages-API path
# ============================================================
# Many current Claude models on Bedrock are INFERENCE_PROFILE-only — the
# bare "anthropic.claude-haiku-4-5" ID 400s with "on-demand throughput
# isn't supported". Use the region-prefixed inference profile ID instead;
# find yours with `aws bedrock list-inference-profiles --type-equals SYSTEM_DEFINED`.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
JUDGE_MODEL_ID=us.anthropic.claude-opus-5   # always Claude/Bedrock, used only for --with-judge scoring

# ============================================================
# Kimi (Moonshot AI) — Bedrock Converse API path
# ============================================================
# ON_DEMAND on Bedrock (no inference profile needed) — verified live.
KIMI_MODEL=moonshotai.kimi-k2.5

# ============================================================
# GLM (Z.AI) — Bedrock Converse API path
# ============================================================
# ON_DEMAND on Bedrock (no inference profile needed) — verified live.
GLM_MODEL=zai.glm-5
